{
  "title": "KubeStellar Console — Self Metrics",
  "description": "Recommendation-only dashboard for the console backend's bounded self-metrics (console_http_requests_total, console_http_request_duration_seconds) exposed at /metrics (see pkg/api/metrics). Import this JSON into a Grafana instance already pointed at a Prometheus that scrapes this console deployment; nothing here configures a data source or exporter automatically. No backend is confirmed for this deployment, so this file is not wired into any deployment or CI step.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "tags": ["kubestellar", "console", "self-metrics"],
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Request rate by status",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(console_http_requests_total[5m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "5xx error rate (ratio)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(console_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(console_http_requests_total[5m]))",
          "legendFormat": "5xx ratio"
        }
      ]
    },
    {
      "id": 3,
      "title": "Request latency (p50 / p95 / p99)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(console_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(console_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(console_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "title": "Requests by route (top 10)",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "topk(10, sum(rate(console_http_requests_total[5m])) by (route))",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "title": "GPU utilization worker poll cycles (rate / p95 duration)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "rate(console_gpu_util_scrape_cycles_total[5m])",
          "legendFormat": "poll cycles/s"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(console_gpu_util_scrape_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 cycle duration"
        }
      ]
    },
    {
      "id": 6,
      "title": "GPU reservation collection outcomes & DCGM/alert errors",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(console_gpu_util_reservation_collect_total[5m])) by (outcome)",
          "legendFormat": "collect: {{outcome}}"
        },
        {
          "expr": "rate(console_gpu_util_dcgm_scrape_errors_total[5m])",
          "legendFormat": "dcgm scrape errors/s"
        },
        {
          "expr": "rate(console_gpu_util_alert_send_errors_total[5m])",
          "legendFormat": "alert send errors/s"
        }
      ]
    }
  ]
}
